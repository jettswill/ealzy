# Leave empty when the API is served from the same origin.
VITE_API_BASE_URL=

# Used only by the Vite development proxy.
VITE_DEV_API_URL=http://localhost:3000

# Telegram Login Widget bot username without @.
VITE_TELEGRAM_BOT_USERNAME=

# Public bot id (the number before ":" in the bot token).
VITE_TELEGRAM_BOT_ID=

# Supabase Auth for Apple, Google and Yandex.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
