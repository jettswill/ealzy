<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Бесплатная учётка Apple: без push и групп приложений, только общая связка ключей,
     чтобы виджет и «Поделиться» видели вход. -->
<plist version="1.0">
<dict>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)ru.ealzy.shared</string>
	</array>
</dict>
</plist>
